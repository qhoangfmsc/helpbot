# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=

# Store to sync into: a display name (found or created) or a resource name (fileSearchStores/...). Default: helpbot-docs
# GEMINI_FILE_SEARCH_STORE=helpbot-docs

# Optional
# HELP_CENTER_URL=https://support.optisigns.com
# ARTICLES_DIR=data/articles
# ARTICLE_IDS_FILE=config/article_ids.txt   # the articles to keep in sync (default: the 40 listed there); set empty for ALL articles
# ARTICLE_LIMIT=40      # partial run: only the N most recently updated articles; never deletes
# UPLOAD_WORKERS=4
# GEMINI_MODEL=gemini-3.5-flash-lite   # used by scripts/chat.py
